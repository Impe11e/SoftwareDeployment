            "network_config": "",
            "pool": "default",
            "user_data": "#cloud-config\n\nhostname: db\nmanage_etc_hosts: true\n\nssh_pwauth: true\ndisable_root: true\n\nusers:\n  - default\n\n  - name: ansible\n    groups: sudo\n    shell: /bin/bash\n    sudo: ALL=(ALL) NOPASSWD:ALL\n    lock_passwd: false\n    plain_text_passwd: \"12345678\"\n    ssh_authorized_keys:\n      - ssh-rsa  student@nodeserver3\n\n\n  - name: teacher\n    groups: sudo\n    shell: /bin/bash\n    sudo: ALL=(ALL) ALL\n    lock_passwd: false\n    plain_text_passwd: \"12345678\"\n\n  - name: operator\n    groups: sudo\n    shell: /bin/bash\n    sudo: ALL=(ALL) NOPASSWD:/usr/bin/systemctl start mywebapp,/usr/bin/systemctl stop mywebapp,/usr/bin/systemctl restart mywebapp,/usr/bin/systemctl status mywebapp,/usr/bin/systemctl reload nginx\n    lock_passwd: false\n    plain_text_passwd: \"12345678\"\n\n  - name: app\n    system: true\n    shell: /usr/sbin/nologin\n\npackages:\n  - qemu-guest-agent\n\nruncmd:\n  - systemctl enable ssh\n  - systemctl restart ssh"
          },
